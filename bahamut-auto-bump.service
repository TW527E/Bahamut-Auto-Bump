[Unit]
Description=Bahamut daily auto bump
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Bahamut-Auto-Bump
ExecStart=/opt/Bahamut-Auto-Bump/.venv/bin/python /opt/Bahamut-Auto-Bump/bahamut_auto_bump.py --config /opt/Bahamut-Auto-Bump/config.toml
Restart=always
RestartSec=30
User=bahamut-bump
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/Bahamut-Auto-Bump

[Install]
WantedBy=multi-user.target
